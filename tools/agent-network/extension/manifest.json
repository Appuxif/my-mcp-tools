{
  "manifest_version": 3,
  "name": "Agent Network Wake",
  "version": "0.5.0",
  "description": "ChatGPT Agent Network: identity migration across chats, safe profile reuse and opt-in HUD.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Network",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "agent-status.js",
        "agent-hud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "agent-hud.css"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
