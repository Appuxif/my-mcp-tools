# Copy to .env (chmod 600). Never commit .env.
# OpenAI Secure MCP Tunnel: obtain in https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=
CONTROL_PLANE_API_KEY=
# Optional: if routing through a proxy / VPN (the system VPN normally requires no config)
# HTTPS_PROXY=http://127.0.0.1:7890

# Add any variables referenced by config/mcp.json below, e.g. MY_SERVICE_TOKEN=...

# SSH fallback: local login-protected mcp-hub via one reverse tunnel
EXTERNAL_URL=https://mcp.example.com
PASSWORD_HASH=
SSH_TARGET=user@your-vps
SSH_REMOTE_PORT=17690
MCP_PORT=7690
